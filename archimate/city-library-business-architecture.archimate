<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="City Library Business Architecture" id="id-2b0c639b388044d09709ceaaadbcf40f" version="5.0.0">
  <folder name="Strategy" id="id-11ef70cadc7843178eb7ce1bcda1bbd8" type="strategy"/>
  <folder name="Business" id="id-86f43a985e6a448393270a183e2c6d67" type="business">
    <element xsi:type="archimate:BusinessActor" name="City Library" id="id-4adfd5a7ca544ff29cde646a61701fef">
      <documentation>The organizational unit that operates the public library and employs its staff.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Anna" id="id-0286ec88811f48fba9c921155f60fb42">
      <documentation>An employee of the City Library who works on the reference desk.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Mark" id="id-aefaf8d0957b4e38989585321bfd6382">
      <documentation>An employee of the City Library who supports the digital catalogue and e-resources.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Reference Librarian" id="id-023c1109d853411393758032d1434986">
      <documentation>Responsible for helping patrons find information and use library resources.</documentation>
    </element>
    <element xsi:type="archimate:BusinessCollaboration" name="Digital Services Team" id="id-92e549dbe73f4e66aa32bc703cf707e2">
      <documentation>A collaboration formed to jointly deliver online reference and digital-resource support to patrons.</documentation>
    </element>
  </folder>
