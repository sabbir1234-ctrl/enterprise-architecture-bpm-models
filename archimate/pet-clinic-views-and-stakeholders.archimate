<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Pet Clinic - Enterprise Architecture (Assignment 5)" id="id-model-petclinic-a5" version="5.0.0">
  <purpose>Integrated ArchiMate model of the Pet Clinic: business layer (Lab 1/2), application layer (Lab 3), technology layer (Lab 4/Assignment 4) and stakeholder views (Assignment 5). Group: MD Sifaur Rahman, Sabbir Hossain Akanda, Samiul Haque Mahin, Rakibul Hasan Rony.</purpose>
  <folder name="Strategy" id="pc5-f-0140" type="strategy"/>
  <folder name="Business" id="pc5-f-0141" type="business">
    <element xsi:type="archimate:BusinessActor" name="Pet Owner" id="pc5-id-0001">
      <documentation>Customer who brings a pet to the clinic.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Clinic Staff" id="pc5-id-0002">
      <documentation>Employees of the Pet Clinic.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Front Desk Staff" id="pc5-id-0003">
      <documentation>Handles bookings, check-in and payment.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Veterinarian" id="pc5-id-0004">
      <documentation>Examines and treats animals.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Clinic Web Interface" id="pc5-id-0005">
      <documentation>Online channel used by pet owners.</documentation>
    </element>
