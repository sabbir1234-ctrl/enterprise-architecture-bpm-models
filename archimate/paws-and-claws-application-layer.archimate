<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Paws &amp; Claws Pet Clinic - Application Layer" id="id-46cc956aca574553a34076a63414ce21" version="5.0.0">
  <purpose>ArchiMate model extending the Paws &amp; Claws Pet Clinic Business Layer with an Application Layer supporting the appointment booking and medical record processes.</purpose>
  <folder name="Strategy" id="id-c562b258bced49958fcf2520aa522525" type="strategy"/>
  <folder name="Business" id="id-c208682b8cbb478288153afe377ad3a3" type="business">
    <element xsi:type="archimate:BusinessRole" name="Front Desk" id="id-e3e9e942e2b641c4b5ecb17207141a1d">
      <documentation>Role responsible for receiving requests, checking availability, scheduling and confirming appointments.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Pet Owner" id="id-ef31f3f26b004fd4989a1d69b59138e7">
      <documentation>Customer of the clinic. Owns a pet and requests, attends and receives veterinary appointments.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Veterinarian" id="id-f3803f445ed14802887b851ab0c9905a">
      <documentation>Role responsible for examining the pet and recording the outcome of the visit.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Appointment Scheduling Service" id="id-61231d7f462c4998b85ab395540bc5a2">
      <documentation>Service offered to Pet Owners: getting a veterinary appointment booked and confirmed with a suitable veterinarian and time.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-7e0263281dcf414fb7a2b9d46c66d097" type="application">
    <element xsi:type="archimate:ApplicationInterface" name="Front Desk UI" id="id-0074790ff10640b69d580dc9dc8af6df">
      <documentation>Interface through which Front Desk staff access the Appointment Scheduling Service.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Appointment Scheduling Service" id="id-7e62a81127d843139f7ef6b44ba4fdf4">
      <documentation>Application service realized by the Appointment Scheduling System; supports the business Appointment Scheduling Service.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Web Portal UI" id="id-23634a8325784e94be82610dde0c111c">
      <documentation>Interface through which the Pet Owner accesses the Appointment Scheduling Service online.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Vet Console UI" id="id-4d4b026ace57498b89a15b0913f46986">
      <documentation>Interface through which the Veterinarian accesses the Medical Record Service.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Medical Record Service" id="id-bb7d077a7da241d8bd72a081b0176adb">
      <documentation>Application service realized by the Clinic EMR System; provides access to patient history and treatment records.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Appointment Scheduling System" id="id-439898a405eb4f3b9562f8685a3e4be7">
      <documentation>Software system that manages appointment slots, bookings and confirmations for the clinic.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Clinic EMR System" id="id-8e8f0e4969bf450c87621cdaec9335ea">
      <documentation>Electronic Medical Record system storing patient and treatment history.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Billing System" id="id-6a7f18a3ff1941e0b989091cf65723e9">
      <documentation>Software system that generates and tracks invoices for veterinary visits.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Manage Appointment Data" id="id-6b4f8b4ba601480296415f3b55207393">
      <documentation>Internal function of the Appointment Scheduling System that maintains appointment slots and statuses.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Process Appointment Booking" id="id-47542f344f894f6f93a41ba847a41ad5">
      <documentation>Automated process that validates a booking request and creates a confirmed appointment.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Appointment Record" id="id-2a9f83e535d04bdebc3d1d7fbd098e8f">
      <documentation>Data object holding date, time, pet owner, pet and veterinarian for a booked appointment.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Patient Medical History" id="id-61d467b761954c5d870b44415b8d2721">
      <documentation>Data object holding a pet's past visits, diagnoses and treatments.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Invoice Record" id="id-3920d9830f2a4fb7800342e79d6f2ba2">
      <documentation>Data object holding the billed amount and payment status for a visit.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-8c7a7d208b0648009cfb876d07ae6c32" type="technology"/>
