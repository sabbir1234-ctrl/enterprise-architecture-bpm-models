<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://paws-and-claws.example/bpmn">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Paws &amp; Claws Pet Clinic" processRef="Process_Handle_Appointment"/></bpmn:collaboration>
<bpmn:process id="Process_Handle_Appointment" name="Handle Appointment" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_owner" name="Pet Owner (Client)"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>R</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_coord" name="Appointment Coordinator"><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>TM</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>TN</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_vet" name="Attending Veterinarian"><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Appointment Requested"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_S"/></bpmn:startEvent>
<bpmn:task id="T1" name="Register Appointment Request"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:businessRuleTask id="T2" name="Determine Slot Availability"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G1" name="Slot available?" gatewayDirection="Diverging"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T3" name="Propose Alternative Slot"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
<bpmn:userTask id="R" name="Review Proposed Slot"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G2" name="Alternative accepted?" gatewayDirection="Diverging"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E2" name="Appointment Not Booked"><bpmn:incoming>f8</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T4" name="Confirm Appointment"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:intermediateCatchEvent id="TM" name="Visit Day"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:timerEventDefinition id="TED_1"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="G3" name="Pet arrived?" gatewayDirection="Diverging"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="TN" name="Record No-Show"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E3" name="Appointment Missed"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T5" name="Check In Patient"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
<bpmn:task id="T6" name="Examine and Treat Pet"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task>
<bpmn:task id="T7" name="Record Visit Results"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task>
<bpmn:task id="T8" name="Issue Invoice"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:task>
<bpmn:userTask id="T9" name="Pay Invoice"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E1" name="Visit Completed and Paid"><bpmn:incoming>f19</bpmn:incoming></bpmn:endEvent>
<bpmn:textAnnotation id="TA1"><bpmn:text>DMN decision: Slot Availability (result: "Slot available" / "No slot available")</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As1" sourceRef="T2" targetRef="TA1"/>
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2"/>
<bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="G1"/>
<bpmn:sequenceFlow id="f4" name="No slot available" sourceRef="G1" targetRef="T3"/>
<bpmn:sequenceFlow id="f5" name="Slot available" sourceRef="G1" targetRef="T4"/>
<bpmn:sequenceFlow id="f6" sourceRef="T3" targetRef="R"/>
<bpmn:sequenceFlow id="f7" sourceRef="R" targetRef="G2"/>
<bpmn:sequenceFlow id="f8" name="No" sourceRef="G2" targetRef="E2"/>
<bpmn:sequenceFlow id="f9" name="Yes" sourceRef="G2" targetRef="T4"/>
<bpmn:sequenceFlow id="f10" sourceRef="T4" targetRef="TM"/>
<bpmn:sequenceFlow id="f11" sourceRef="TM" targetRef="G3"/>
<bpmn:sequenceFlow id="f12" name="Yes" sourceRef="G3" targetRef="T5"/>
<bpmn:sequenceFlow id="f13" name="No" sourceRef="G3" targetRef="TN"/>
<bpmn:sequenceFlow id="f14" sourceRef="TN" targetRef="E3"/>
<bpmn:sequenceFlow id="f15" sourceRef="T5" targetRef="T6"/>
<bpmn:sequenceFlow id="f16" sourceRef="T6" targetRef="T7"/>
<bpmn:sequenceFlow id="f17" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="f18" sourceRef="T8" targetRef="T9"/>
<bpmn:sequenceFlow id="f19" sourceRef="T9" targetRef="E1"/>
</bpmn:process>
