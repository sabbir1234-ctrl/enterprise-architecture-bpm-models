<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RiversideAutomation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
<bpmn:message id="msg_request" name="bookLoanRequest" />
<bpmn:error id="err_student" name="Student not found" errorCode="STUDENT_NOT_FOUND" /><bpmn:error id="err_book" name="Book not found" errorCode="BOOK_NOT_FOUND" />
<bpmn:process id="BorrowBookProcess" name="Riverside Library - Borrow a Book (automated)" isExecutable="true">
<bpmn:startEvent id="start" name="Loan request received (REST)"><bpmn:documentation>Started by the REST API (POST /v2/messages/publication, message name bookLoanRequest) with variables studentId and bookId.</bpmn:documentation><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="med_start" messageRef="msg_request" /></bpmn:startEvent>
<bpmn:serviceTask id="t_student" name="Get student (Student Registry)"><bpmn:documentation>REST connector: GET https://api.npoint.io/ee87d0a56ae04d72e0eb/students/{studentId} (mock Student Registry). 404 -&gt; BPMN error STUDENT_NOT_FOUND.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=&quot;https://api.npoint.io/ee87d0a56ae04d72e0eb/students/&quot; + studentId" target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={studentName: body.name, membershipStatus: body.membershipStatus, unpaidFines: body.unpaidFines, overdueItems: body.overdueItems, borrowerType: body.borrowerType}" /><zeebe:header key="errorExpression" value="=if error.code = &quot;404&quot; then bpmnError(&quot;STUDENT_NOT_FOUND&quot;, &quot;Student not found in the Student Registry&quot;) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_book" name="Get book data (Library Catalog)"><bpmn:documentation>REST connector: GET https://api.npoint.io/ee87d0a56ae04d72e0eb/books/{bookId} (mock Library Catalog). 404 -&gt; BPMN error BOOK_NOT_FOUND.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=&quot;https://api.npoint.io/ee87d0a56ae04d72e0eb/books/&quot; + bookId" target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={bookTitle: body.title, copyStatus: body.copyStatus, reservedForOthers: body.reservedForOthers}" /><zeebe:header key="errorExpression" value="=if error.code = &quot;404&quot; then bpmnError(&quot;BOOK_NOT_FOUND&quot;, &quot;Book not found in the Library Catalog&quot;) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="t_decide" name="Determine loan approval (DMN)"><bpmn:documentation>Evaluates DMN decision loanApproval (Riverside_Loan_Decision.dmn) -&gt; loanResult {loanDecision, loanPeriodDays, message}.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="loanApproval" resultVariable="loanResult" /></bpmn:extensionElements><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="g_loan" name="Loan decision?" default="f10"><bpmn:documentation>Routes on loanResult.loanDecision. Rejected is the default flow, so the gateway can never get stuck (no incident).</bpmn:documentation><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_due" name="Calculate due date"><bpmn:extensionElements><zeebe:script expression="=string(today() + duration(&quot;P&quot; + string(loanResult.loanPeriodDays) + &quot;D&quot;))" resultVariable="dueDate" /></bpmn:extensionElements><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_confirm" name="Create loan confirmation"><bpmn:extensionElements><zeebe:script expression="={status: &quot;APPROVED&quot;, studentId: studentId, studentName: studentName, bookId: bookId, bookTitle: bookTitle, loanPeriodDays: loanResult.loanPeriodDays, dueDate: dueDate, message: loanResult.message}" resultVariable="loanOutcome" /></bpmn:extensionElements><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="end_borrowed" name="Book borrowed"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="t_reserve" name="Place reservation in queue"><bpmn:extensionElements><zeebe:script expression="={status: &quot;RESERVED&quot;, studentId: studentId, bookId: bookId, bookTitle: bookTitle, message: loanResult.message}" resultVariable="loanOutcome" /></bpmn:extensionElements><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="end_reserved" name="Book reserved"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="t_reject" name="Create rejection notice"><bpmn:extensionElements><zeebe:script expression="={status: &quot;REJECTED&quot;, studentId: studentId, bookId: bookId, bookTitle: bookTitle, message: loanResult.message}" resultVariable="loanOutcome" /></bpmn:extensionElements><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="end_rejected" name="Loan rejected"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="g_err"><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_invalid" name="Create invalid request notice"><bpmn:extensionElements><zeebe:script expression="={status: &quot;INVALID_REQUEST&quot;, studentId: studentId, bookId: bookId, message: &quot;Student or book not found in the external systems&quot;}" resultVariable="loanOutcome" /></bpmn:extensionElements><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="end_invalid" name="Request invalid"><bpmn:incoming>f15</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="b_student" name="Student not found" attachedToRef="t_student"><bpmn:outgoing>f12</bpmn:outgoing><bpmn:errorEventDefinition id="b_student_def" errorRef="err_student" /></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="b_book" name="Book not found" attachedToRef="t_book"><bpmn:outgoing>f13</bpmn:outgoing><bpmn:errorEventDefinition id="b_book_def" errorRef="err_book" /></bpmn:boundaryEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_student" />
<bpmn:sequenceFlow id="f2" sourceRef="t_student" targetRef="t_book" />
<bpmn:sequenceFlow id="f3" sourceRef="t_book" targetRef="t_decide" />
<bpmn:sequenceFlow id="f4" sourceRef="t_decide" targetRef="g_loan" />
<bpmn:sequenceFlow id="f5" name="Approved" sourceRef="g_loan" targetRef="t_due"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanResult.loanDecision = &quot;Approved&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="t_due" targetRef="t_confirm" />
<bpmn:sequenceFlow id="f7" sourceRef="t_confirm" targetRef="end_borrowed" />
<bpmn:sequenceFlow id="f8" name="Reserve" sourceRef="g_loan" targetRef="t_reserve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanResult.loanDecision = &quot;Reserve&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" sourceRef="t_reserve" targetRef="end_reserved" />
<bpmn:sequenceFlow id="f10" name="Rejected" sourceRef="g_loan" targetRef="t_reject" />
<bpmn:sequenceFlow id="f11" sourceRef="t_reject" targetRef="end_rejected" />
<bpmn:sequenceFlow id="f12" sourceRef="b_student" targetRef="g_err" />
<bpmn:sequenceFlow id="f13" sourceRef="b_book" targetRef="g_err" />
<bpmn:sequenceFlow id="f14" sourceRef="g_err" targetRef="t_invalid" />
<bpmn:sequenceFlow id="f15" sourceRef="t_invalid" targetRef="end_invalid" />
</bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="BorrowBookProcess">
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="102" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="70.0" y="223.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_student_di" bpmnElement="t_student"><dc:Bounds x="225" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_book_di" bpmnElement="t_book"><dc:Bounds x="385" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_decide_di" bpmnElement="t_decide"><dc:Bounds x="545" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g_loan_di" bpmnElement="g_loan" isMarkerVisible="true"><dc:Bounds x="735" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="725.0" y="151.0" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_due_di" bpmnElement="t_due"><dc:Bounds x="865" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_confirm_di" bpmnElement="t_confirm"><dc:Bounds x="1025" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_borrowed_di" bpmnElement="end_borrowed"><dc:Bounds x="1222" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1190.0" y="223.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_reserve_di" bpmnElement="t_reserve"><dc:Bounds x="865" y="300" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_reserved_di" bpmnElement="end_reserved"><dc:Bounds x="1062" y="322" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1030.0" y="363.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_reject_di" bpmnElement="t_reject"><dc:Bounds x="865" y="430" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected"><dc:Bounds x="1062" y="452" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1030.0" y="493.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g_err_di" bpmnElement="g_err" isMarkerVisible="true"><dc:Bounds x="415" y="575" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_invalid_di" bpmnElement="t_invalid"><dc:Bounds x="545" y="560" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_invalid_di" bpmnElement="end_invalid"><dc:Bounds x="742" y="582" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="710.0" y="623.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_student_di" bpmnElement="b_student"><dc:Bounds x="262" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="302" y="252" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="b_book_di" bpmnElement="b_book"><dc:Bounds x="422" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="462" y="252" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="138" y="200" /><di:waypoint x="225" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="335" y="200" /><di:waypoint x="385" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="495" y="200" /><di:waypoint x="545" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="655" y="200" /><di:waypoint x="735" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="785" y="200" /><di:waypoint x="865" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="793" y="180" width="62" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="975" y="200" /><di:waypoint x="1025" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1135" y="200" /><di:waypoint x="1222" y="200" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="760" y="225" /><di:waypoint x="760" y="340" /><di:waypoint x="865" y="340" /><bpmndi:BPMNLabel><dc:Bounds x="768" y="320" width="55" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="975" y="340" /><di:waypoint x="1062" y="340" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="760" y="225" /><di:waypoint x="760" y="470" /><di:waypoint x="865" y="470" /><bpmndi:BPMNLabel><dc:Bounds x="768" y="450" width="62" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="975" y="470" /><di:waypoint x="1062" y="470" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="280" y="258" /><di:waypoint x="280" y="600" /><di:waypoint x="415" y="600" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="440" y="258" /><di:waypoint x="440" y="575" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="465" y="600" /><di:waypoint x="545" y="600" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="655" y="600" /><di:waypoint x="742" y="600" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
