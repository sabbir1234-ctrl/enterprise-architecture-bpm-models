<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Riverside_Loan_Decision" name="Riverside Library - Loan Approval" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
<decision id="borrowerEligibility" name="Determine Borrower Eligibility"><informationRequirement id="borrowerEligibility_req0"><requiredInput href="#in_membership" /></informationRequirement><informationRequirement id="borrowerEligibility_req1"><requiredInput href="#in_fines" /></informationRequirement><informationRequirement id="borrowerEligibility_req2"><requiredInput href="#in_overdue" /></informationRequirement><authorityRequirement id="borrowerEligibility_req3"><requiredAuthority href="#ks_members" /></authorityRequirement><decisionTable id="borrowerEligibility_table" hitPolicy="UNIQUE"><input id="borrowerEligibility_in0" label="Membership status"><inputExpression id="borrowerEligibility_ie0" typeRef="string"><text>membershipStatus</text></inputExpression><inputValues id="borrowerEligibility_iv0"><text>&quot;Active&quot;,&quot;Expired&quot;,&quot;Suspended&quot;</text></inputValues></input><input id="borrowerEligibility_in1" label="Unpaid fines (EUR)"><inputExpression id="borrowerEligibility_ie1" typeRef="number"><text>unpaidFines</text></inputExpression></input><input id="borrowerEligibility_in2" label="Overdue items"><inputExpression id="borrowerEligibility_ie2" typeRef="number"><text>overdueItems</text></inputExpression></input><output id="borrowerEligibility_out0" label="Eligible" name="eligible" typeRef="boolean"></output><output id="borrowerEligibility_out1" label="Reason" name="reason" typeRef="string"></output><rule id="borrowerEligibility_r1"><description>Suspended accounts may not borrow</description><inputEntry id="borrowerEligibility_r1_i0"><text>&quot;Suspended&quot;</text></inputEntry><inputEntry id="borrowerEligibility_r1_i1"><text>-</text></inputEntry><inputEntry id="borrowerEligibility_r1_i2"><text>-</text></inputEntry><outputEntry id="borrowerEligibility_r1_o0"><text>false</text></outputEntry><outputEntry id="borrowerEligibility_r1_o1"><text>&quot;Account suspended&quot;</text></outputEntry></rule><rule id="borrowerEligibility_r2"><description>Membership must be renewed first</description><inputEntry id="borrowerEligibility_r2_i0"><text>&quot;Expired&quot;</text></inputEntry><inputEntry id="borrowerEligibility_r2_i1"><text>-</text></inputEntry><inputEntry id="borrowerEligibility_r2_i2"><text>-</text></inputEntry><outputEntry id="borrowerEligibility_r2_o0"><text>false</text></outputEntry><outputEntry id="borrowerEligibility_r2_o1"><text>&quot;Membership expired&quot;</text></outputEntry></rule><rule id="borrowerEligibility_r3"><description>Fine limit reached</description><inputEntry id="borrowerEligibility_r3_i0"><text>&quot;Active&quot;</text></inputEntry><inputEntry id="borrowerEligibility_r3_i1"><text>&gt;= 10</text></inputEntry><inputEntry id="borrowerEligibility_r3_i2"><text>-</text></inputEntry><outputEntry id="borrowerEligibility_r3_o0"><text>false</text></outputEntry><outputEntry id="borrowerEligibility_r3_o1"><text>&quot;Unpaid fines of 10 EUR or more&quot;</text></outputEntry></rule><rule id="borrowerEligibility_r4"><description>Overdue limit reached</description><inputEntry id="borrowerEligibility_r4_i0"><text>&quot;Active&quot;</text></inputEntry><inputEntry id="borrowerEligibility_r4_i1"><text>&lt; 10</text></inputEntry><inputEntry id="borrowerEligibility_r4_i2"><text>&gt;= 3</text></inputEntry><outputEntry id="borrowerEligibility_r4_o0"><text>false</text></outputEntry><outputEntry id="borrowerEligibility_r4_o1"><text>&quot;3 or more overdue items&quot;</text></outputEntry></rule><rule id="borrowerEligibility_r5"><description>Active member in good standing</description><inputEntry id="borrowerEligibility_r5_i0"><text>&quot;Active&quot;</text></inputEntry><inputEntry id="borrowerEligibility_r5_i1"><text>&lt; 10</text></inputEntry><inputEntry id="borrowerEligibility_r5_i2"><text>&lt; 3</text></inputEntry><outputEntry id="borrowerEligibility_r5_o0"><text>true</text></outputEntry><outputEntry id="borrowerEligibility_r5_o1"><text>&quot;Borrower eligible&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="bookAvailability" name="Determine Book Availability"><informationRequirement id="bookAvailability_req0"><requiredInput href="#in_copyStatus" /></informationRequirement><informationRequirement id="bookAvailability_req1"><requiredInput href="#in_reserved" /></informationRequirement><authorityRequirement id="bookAvailability_req2"><requiredAuthority href="#ks_policy" /></authorityRequirement><decisionTable id="bookAvailability_table" hitPolicy="UNIQUE"><input id="bookAvailability_in0" label="Copy status"><inputExpression id="bookAvailability_ie0" typeRef="string"><text>copyStatus</text></inputExpression><inputValues id="bookAvailability_iv0"><text>&quot;Available&quot;,&quot;On loan&quot;,&quot;Reference only&quot;,&quot;Lost&quot;,&quot;Damaged&quot;</text></inputValues></input><input id="bookAvailability_in1" label="Reserved for another reader"><inputExpression id="bookAvailability_ie1" typeRef="boolean"><text>reservedForOthers</text></inputExpression></input><output id="bookAvailability_out0" label="Book availability" name="bookAvailability" typeRef="string"><outputValues id="bookAvailability_ov0"><text>&quot;Available&quot;,&quot;Reservable&quot;,&quot;Not lendable&quot;</text></outputValues></output><rule id="bookAvailability_r1"><description>Copy on the shelf and free</description><inputEntry id="bookAvailability_r1_i0"><text>&quot;Available&quot;</text></inputEntry><inputEntry id="bookAvailability_r1_i1"><text>false</text></inputEntry><outputEntry id="bookAvailability_r1_o0"><text>&quot;Available&quot;</text></outputEntry></rule><rule id="bookAvailability_r2"><description>Copy is held for another reader</description><inputEntry id="bookAvailability_r2_i0"><text>&quot;Available&quot;</text></inputEntry><inputEntry id="bookAvailability_r2_i1"><text>true</text></inputEntry><outputEntry id="bookAvailability_r2_o0"><text>&quot;Reservable&quot;</text></outputEntry></rule><rule id="bookAvailability_r3"><description>Student can join the reservation queue</description><inputEntry id="bookAvailability_r3_i0"><text>&quot;On loan&quot;</text></inputEntry><inputEntry id="bookAvailability_r3_i1"><text>-</text></inputEntry><outputEntry id="bookAvailability_r3_o0"><text>&quot;Reservable&quot;</text></outputEntry></rule><rule id="bookAvailability_r4"><description>Reference books are used in the library only</description><inputEntry id="bookAvailability_r4_i0"><text>&quot;Reference only&quot;</text></inputEntry><inputEntry id="bookAvailability_r4_i1"><text>-</text></inputEntry><outputEntry id="bookAvailability_r4_o0"><text>&quot;Not lendable&quot;</text></outputEntry></rule><rule id="bookAvailability_r5"><description>Copy cannot be lent</description><inputEntry id="bookAvailability_r5_i0"><text>&quot;Lost&quot;,&quot;Damaged&quot;</text></inputEntry><inputEntry id="bookAvailability_r5_i1"><text>-</text></inputEntry><outputEntry id="bookAvailability_r5_o0"><text>&quot;Not lendable&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="loanApproval" name="Determine Loan Approval"><informationRequirement id="loanApproval_req0"><requiredDecision href="#borrowerEligibility" /></informationRequirement><informationRequirement id="loanApproval_req1"><requiredDecision href="#bookAvailability" /></informationRequirement><informationRequirement id="loanApproval_req2"><requiredInput href="#in_borrowerType" /></informationRequirement><authorityRequirement id="loanApproval_req3"><requiredAuthority href="#ks_policy" /></authorityRequirement><decisionTable id="loanApproval_table" hitPolicy="UNIQUE"><input id="loanApproval_in0" label="Borrower eligible"><inputExpression id="loanApproval_ie0" typeRef="boolean"><text>borrowerEligibility.eligible</text></inputExpression></input><input id="loanApproval_in1" label="Book availability"><inputExpression id="loanApproval_ie1" typeRef="string"><text>bookAvailability</text></inputExpression><inputValues id="loanApproval_iv1"><text>&quot;Available&quot;,&quot;Reservable&quot;,&quot;Not lendable&quot;</text></inputValues></input><input id="loanApproval_in2" label="Borrower type"><inputExpression id="loanApproval_ie2" typeRef="string"><text>borrowerType</text></inputExpression><inputValues id="loanApproval_iv2"><text>&quot;Student&quot;,&quot;Staff&quot;</text></inputValues></input><output id="loanApproval_out0" label="Loan decision" name="loanDecision" typeRef="string"><outputValues id="loanApproval_ov0"><text>&quot;Approved&quot;,&quot;Reserve&quot;,&quot;Rejected&quot;</text></outputValues></output><output id="loanApproval_out1" label="Loan period (days)" name="loanPeriodDays" typeRef="number"></output><output id="loanApproval_out2" label="Message" name="message" typeRef="string"></output><rule id="loanApproval_r1"><description>Borrower is not eligible</description><inputEntry id="loanApproval_r1_i0"><text>false</text></inputEntry><inputEntry id="loanApproval_r1_i1"><text>-</text></inputEntry><inputEntry id="loanApproval_r1_i2"><text>-</text></inputEntry><outputEntry id="loanApproval_r1_o0"><text>&quot;Rejected&quot;</text></outputEntry><outputEntry id="loanApproval_r1_o1"><text>0</text></outputEntry><outputEntry id="loanApproval_r1_o2"><text>borrowerEligibility.reason</text></outputEntry></rule><rule id="loanApproval_r2"><description>Standard student loan</description><inputEntry id="loanApproval_r2_i0"><text>true</text></inputEntry><inputEntry id="loanApproval_r2_i1"><text>&quot;Available&quot;</text></inputEntry><inputEntry id="loanApproval_r2_i2"><text>&quot;Student&quot;</text></inputEntry><outputEntry id="loanApproval_r2_o0"><text>&quot;Approved&quot;</text></outputEntry><outputEntry id="loanApproval_r2_o1"><text>14</text></outputEntry><outputEntry id="loanApproval_r2_o2"><text>&quot;Loan approved for 14 days&quot;</text></outputEntry></rule><rule id="loanApproval_r3"><description>Extended staff loan</description><inputEntry id="loanApproval_r3_i0"><text>true</text></inputEntry><inputEntry id="loanApproval_r3_i1"><text>&quot;Available&quot;</text></inputEntry><inputEntry id="loanApproval_r3_i2"><text>&quot;Staff&quot;</text></inputEntry><outputEntry id="loanApproval_r3_o0"><text>&quot;Approved&quot;</text></outputEntry><outputEntry id="loanApproval_r3_o1"><text>28</text></outputEntry><outputEntry id="loanApproval_r3_o2"><text>&quot;Loan approved for 28 days&quot;</text></outputEntry></rule><rule id="loanApproval_r4"><description>Place student in the reservation queue</description><inputEntry id="loanApproval_r4_i0"><text>true</text></inputEntry><inputEntry id="loanApproval_r4_i1"><text>&quot;Reservable&quot;</text></inputEntry><inputEntry id="loanApproval_r4_i2"><text>-</text></inputEntry><outputEntry id="loanApproval_r4_o0"><text>&quot;Reserve&quot;</text></outputEntry><outputEntry id="loanApproval_r4_o1"><text>0</text></outputEntry><outputEntry id="loanApproval_r4_o2"><text>&quot;Book not available now - added to reservation queue&quot;</text></outputEntry></rule><rule id="loanApproval_r5"><description>Book cannot leave the library</description><inputEntry id="loanApproval_r5_i0"><text>true</text></inputEntry><inputEntry id="loanApproval_r5_i1"><text>&quot;Not lendable&quot;</text></inputEntry><inputEntry id="loanApproval_r5_i2"><text>-</text></inputEntry><outputEntry id="loanApproval_r5_o0"><text>&quot;Rejected&quot;</text></outputEntry><outputEntry id="loanApproval_r5_o1"><text>0</text></outputEntry><outputEntry id="loanApproval_r5_o2"><text>&quot;This copy cannot be lent (reference, lost or damaged)&quot;</text></outputEntry></rule></decisionTable></decision>
<inputData id="in_membership" name="Membership status"><variable id="in_membership_var" name="membershipStatus" typeRef="string" /></inputData>
<inputData id="in_fines" name="Unpaid fines (EUR)"><variable id="in_fines_var" name="unpaidFines" typeRef="number" /></inputData>
<inputData id="in_overdue" name="Overdue items"><variable id="in_overdue_var" name="overdueItems" typeRef="number" /></inputData>
<inputData id="in_borrowerType" name="Borrower type"><variable id="in_borrowerType_var" name="borrowerType" typeRef="string" /></inputData>
<inputData id="in_copyStatus" name="Copy status"><variable id="in_copyStatus_var" name="copyStatus" typeRef="string" /></inputData>
<inputData id="in_reserved" name="Reserved for another reader"><variable id="in_reserved_var" name="reservedForOthers" typeRef="boolean" /></inputData>
<knowledgeSource id="ks_policy" name="Riverside Library Lending Regulations"><description>Lending policy: loan period 14 days (students) / 28 days (staff); reference, lost and damaged copies are not lent; copies held for a reservation go to the queue.</description></knowledgeSource>
<knowledgeSource id="ks_members" name="Membership and Fines Policy"><description>Borrowing is blocked for suspended or expired memberships, unpaid fines of 10 EUR or more, or 3 or more overdue items.</description></knowledgeSource>
